###############################
# Docker Database Configuration
###############################
POSTGRES_USER=admin
POSTGRES_PASSWORD=SuperSecretPassword123!
POSTGRES_DB=mod_b
DATABASE_URL=postgres://admin:SuperSecretPassword123!@db:5432/mod_b

###############################
# Payload Configuration
###############################

# Set to "yes" to install dependencies and build the application.
INSTALL=yes
# Run Payload database migrations before startup.
MIGRATE=yes
# Build the application before starting production mode.
BUILD=yes


# The URL where your application will be accessible. Used for generating links in emails, etc.
APP_URL=http://localhost:3000

# Used to encrypt JWT tokens
# https://payloadsecret.com/
PAYLOAD_SECRET=

# Port on which Payload CMS will run.
PAYLOAD_PORT=3000

# next.config.ts without protocol. Use comma-separated list
SERVER_URLS=localhost:3000

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to validate preview requests
PREVIEW_SECRET=

# PAYLOAD_TEMPLATE can be set to "blank" or "website".
PAYLOAD_TEMPLATE=blank
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Generate a strong random value before production use.
AUTH_SECRET=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000

# Turnstile
ENABLE_TURNSTILE=false
NEXT_PUBLIC_ENABLE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key

###############################
# SMTP Mail Server Configuration
# Required only if your application sends emails
# (e.g. email verification or password reset).
###############################

SMTP_HOST=
SMTP_PORT=587

# Port 587 (STARTTLS)
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
#
# Port 465 (SMTPS)
# SMTP_SECURE=true
# SMTP_REQUIRE_TLS=false
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

SMTP_USER=
SMTP_PASSWORD=

SMTP_FROM_NAME=Mod-B
SMTP_FROM_EMAIL=

# Optional: Override the hostname used for TLS certificate validation.
# Most users do not need this.
SMTP_TLS_SERVERNAME=

# Keep TLS certificate validation enabled.
SMTP_REJECT_UNAUTHORIZED=true

# Optional: Internal SMTP server IP.
# Most users can leave this blank.
# Use only if SMTP_HOST has a public hostname but must resolve to a private IP
# from inside the Docker network.
# Requires docker-compose.override.yml.
SMTP_INTERNAL_IP=

###############################
# Google OAuth Configuration
###############################
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

###############################
# Naver OAuth Configuration
###############################
AUTH_NAVER_ID=your-naver-client-id
AUTH_NAVER_SECRET=your-naver-client-secret

################################
# Kakao OAuth Configuration
################################
AUTH_KAKAO_ID=your-kakao-client-id
AUTH_KAKAO_SECRET=your-kakao-client-secret

#################################
# Facebook OAuth Configuration
##################################
AUTH_FACEBOOK_ID=your-facebook-app-id
AUTH_FACEBOOK_SECRET=your-facebook-app-secret

#################################
# Allow seeding the example site in production.
# WARNING: Use only if you understand the consequences.
# Set to: I_UNDERSTAND_THE_RISK
#################################
#ALLOW_PRODUCTION_SEED=I_UNDERSTAND_THE_RISK